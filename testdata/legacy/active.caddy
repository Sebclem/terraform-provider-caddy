unifi.sebclem.fr {
  tls /etc/ssl/acme/-.sebclem.fr/fullchain.pem /etc/ssl/acme/-.sebclem.fr/key.pem 
  reverse_proxy 10.24.0.3:11443 {

    health_uri /
    health_follow_redirects
    health_fails 3
    health_timeout 20s
    

    




    transport http {
      


      tls


      tls_insecure_skip_verify




    }



    header_up Host {hostport}





  }


  log {
    output file /var/log/caddy/unifi.sebclem.fr.log {
      mode 640
      roll_size 50mb
      roll_local_time
    }
  }
  handle_errors {
    root /srv
    rewrite * /{err.status_code}.html
    file_server
  }
  
  
}


