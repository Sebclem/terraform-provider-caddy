grafana-webdav.sebclem.fr {
  tls /etc/ssl/acme/-.sebclem.fr/fullchain.pem /etc/ssl/acme/-.sebclem.fr/key.pem 
  reverse_proxy docker.home:80 {
    

  }


  log {
    output file /var/log/caddy/grafana-webdav.sebclem.fr.log {
      mode 640
      roll_size 50mb
      roll_local_time
    }
  }
  handle_errors {
    root /srv
    rewrite * /{err.status_code}.html
    file_server
  }
  




  @write_nonlocal {
    


    method POST PUT DELETE


    not client_ip 10.0.0.0/8 168.119.68.214/32 2001:470:1f13:b58::/64 2001:861:5286:d5e0::/60




  }



  error @write_nonlocal "Unauthorized" 403




  
}


