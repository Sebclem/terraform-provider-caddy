



{
  




  servers {
    


    trusted_proxies static 10.0.0.0/8




  }





  metrics {
    


    per_host




  }



  admin :2019




}


(protected) {
  




  forward_auth auth.home:9091 {
    


    uri /api/authz/forward-auth


    copy_headers Remote-User Remote-Groups Remote-Email Remote-Name




  }





}

(whitelist_local) {
  


  @denied not client_ip 10.0.0.0/8 168.119.68.214/32 2001:470:1f13:b58::/64 2001:861:5286:d5e0::/60


  error @denied "Unauthorized" 403




}






authelia.sebclem.fr {
  tls /etc/ssl/acme/-.sebclem.fr/fullchain.pem /etc/ssl/acme/-.sebclem.fr/key.pem 
  reverse_proxy auth.home:9091 {

    health_uri /
    health_follow_redirects
    health_fails 3
    health_timeout 20s
    

  }


  log {
    output file /var/log/caddy/authelia.sebclem.fr.log {
      mode 640
      roll_size 50mb
      roll_local_time
    }
  }
  handle_errors {
    root /srv
    rewrite * /{err.status_code}.html
    file_server
  }
  
  
}


