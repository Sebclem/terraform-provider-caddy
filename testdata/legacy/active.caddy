  tls /etc/ssl/acme/-.sebclem.fr/fullchain.pem /etc/ssl/acme/-.sebclem.fr/key.pem 
  reverse_proxy docker.home:80 {
    

  }

  import protected


  import whitelist_local

  log {
    output file /var/log/caddy/radarr.sebclem.fr.log {
      mode 640
      roll_size 50mb
      roll_local_time
    }
  }
  handle_errors {
    root /srv
    rewrite * /{err.status_code}.html
    file_server
  }
  
  
}


