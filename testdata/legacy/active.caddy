frigate.sebclem.fr {
  tls /etc/ssl/acme/-.sebclem.fr/fullchain.pem /etc/ssl/acme/-.sebclem.fr/key.pem 
  reverse_proxy frigate.home:8971 {

    health_uri /
    health_follow_redirects
    health_fails 3
    health_timeout 20s
    

    




