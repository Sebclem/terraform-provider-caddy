      tls_insecure_skip_verify




    }






  }

  import protected


  import whitelist_local

  log {
    output file /var/log/caddy/frigate.sebclem.fr.log {
      mode 640
      roll_size 50mb
      roll_local_time
    }
  }
  handle_errors {
    root /srv
    rewrite * /{err.status_code}.html
    file_server
  }
  
  
}


